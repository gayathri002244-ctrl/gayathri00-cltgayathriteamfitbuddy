# ============================================================
# FITBUDDY ENVIRONMENT CONFIGURATION
# ============================================================

# Add your Gemini API key here.
# Do not share this key publicly.
GEMINI_API_KEY=your-gemini-api-key


# ============================================================
# GEMINI MODELS
# ============================================================

# Workout generation model
# Gemini model selection
FITBUDDY_WORKOUT_MODEL=gemini-3.5-flash-lite

# Nutrition/recovery model
FITBUDDY_NUTRITION_MODEL=gemini-3.5-flash-lite


# ============================================================
# DATABASE
# ============================================================

DATABASE_URL=sqlite:///./fitbuddy.db


# ============================================================
# OPTIONAL ADMIN SECURITY
# ============================================================

# If empty, the local dashboard is accessible without a key.
# For example:
#
# ADMIN_KEY=my-secret-admin-key
#
ADMIN_KEY=